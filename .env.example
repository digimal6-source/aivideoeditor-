# =============================================================================
# Shortform Clipper - environment configuration
# Copy this file to `.env` and edit as needed:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# (This app needs no API keys at all - there are no paid services involved.)
# =============================================================================

# --- HTTP server -------------------------------------------------------------
# 0.0.0.0 is required for GitHub Codespaces port forwarding to work.
API_HOST=0.0.0.0
API_PORT=8000
# Set to your frontend origin if you later deploy the UI separately (e.g. Vercel).
CORS_ALLOW_ORIGIN=*

# --- Frontend ----------------------------------------------------------------
# Empty = the UI talks to the same origin that served it (the default in Codespaces).
# Set to e.g. https://my-render-worker.example.com when the UI is hosted elsewhere.
API_BASE_URL=

# --- Storage -----------------------------------------------------------------
# All runtime data lives under DATA_DIR. Point these at a mounted volume or an
# object-storage-backed FUSE mount when you move off Codespaces.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
JOBS_DIR=./data/jobs
FONTS_DIR=./fonts
PRESETS_FILE=./data/presets.json

# --- Limits ------------------------------------------------------------------
# 4 GiB default upload ceiling.
MAX_UPLOAD_BYTES=4294967296
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.m4v,.avi
# Finished jobs (and their outputs) are deleted after this many hours.
JOB_RETENTION_HOURS=12
# Rendering is CPU-bound; 1 is correct for a 2-core Codespace.
MAX_CONCURRENT_JOBS=1

# --- FFmpeg ------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SECONDS=3600

# --- Transcription -----------------------------------------------------------
# faster_whisper = local, free, open source (recommended)
# manual         = you paste the caption text yourself, timings are aligned to speech
# none           = no captions
TRANSCRIPTION_BACKEND=faster_whisper

# tiny   = fastest, least accurate      (~75 MB)
# base   = balanced, good for Codespaces (~145 MB)  <-- default
# small  = noticeably better, ~2-3x slower on CPU   (~480 MB)
# medium = best of the CPU-practical options, slow  (~1.5 GB)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 'auto' detects the language; set e.g. 'en' to skip detection and save time.
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=1
# The model is downloaded once and cached here, not re-downloaded per job.
WHISPER_DOWNLOAD_ROOT=./data/models

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
